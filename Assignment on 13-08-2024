// Items.js
import React from 'react';

function Items({ items }) {
  return (
    <div>
      <h2>Our Sweet Items</h2>
      <ul>
        {/* Map through the items array and display each item in a list */}
        {items.map((item, index) => (
          <li key={index}>{item}</li>
        ))}
      </ul>
    </div>
  );
}

export default Items;
