
import React from 'react';
import Items from './Items'; 

function App() {
  // List of sweets items
  const sweetsList = [
    "Chocolate Cake",
    "Vanilla Ice Cream",
    "Apple Pie",
    "Gummy Bears",
    "Lemon Tart",
    "Strawberry Cheesecake"
  ];

  return (
    <div>
      <h1>Welcome to the Sweet Shop</h1>
      {/* Pass the sweetsList to the Items component */}
      <Items items={sweetsList} />
    </div>
  );
}

export default App;
